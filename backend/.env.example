# Copy to backend/.env and fill in real values. Never commit backend/.env.

# ---- Database (async driver for the app, sync driver for Alembic) ----
DATABASE_URL=postgresql+asyncpg://fifa:fifa@localhost:5544/fifa
DATABASE_URL_SYNC=postgresql+psycopg://fifa:fifa@localhost:5544/fifa

# ---- API-Football (API-SPORTS) ----
# Get a free key at https://dashboard.api-football.com/ . Free plan = 100 req/day.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_DAILY_BUDGET=100
API_FOOTBALL_SAFETY_RESERVE=20

# ---- Application ----
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
