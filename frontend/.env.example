# Local dev uses the Vite proxy (see vite.config.ts), so the default "/api" works
# with no .env at all. For production builds (Vercel/Netlify), set VITE_API_BASE in
# the host's environment-variable settings to your deployed backend URL + "/api":
#   VITE_API_BASE=https://fifa-wc-api.onrender.com/api
VITE_API_BASE=/api
